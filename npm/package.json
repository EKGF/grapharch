{
  "name": "grapharch",
  "version": "0.2.6",
  "description": "Generate documentation websites, specifications, and PDFs from a documentation knowledge graph",
  "license": "MIT",
  "homepage": "https://ekgf.github.io/grapharch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EKGF/grapharch.git",
