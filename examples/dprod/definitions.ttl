# GraphArch publication definitions for the pinned DPROD showcase. These
# definitions are controlled separately from the DPROD content in content/,
# which carries no GraphArch configuration.
@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix ex: <urn:dprod-showcase:> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:project a ga:Project ; dct:title "Data Product Ontology (DPROD)" ;
    ga:repository <https://github.com/EKGF/dprod> ; ga:scope ex:scope ;
    ga:target ex:specification, ex:website, ex:pdf ;
    ga:collector ex:collector:abstract, ex:collector:status, ex:collector:overview,
        ex:collector:example, ex:collector:ontology, ex:collector:shapes,
        ex:collector:website:index, ex:collector:website:getting-started,
        ex:collector:website:stories ;
    ga:documentor ex:reference .
ex:scope a ga:Scope .

# Targets.
ex:specification a ga:Target ; dct:title "DPROD ontology and SHACL reference" ;
    ga:subtitle "Generated from native RDF sources" ;
    ga:scope ex:scope ; ga:profile ex:profile ; ga:renderer ga:SpecificationRenderer ; ga:destination "specification" ;
    ga:publisher <urn:uuid:6c1408aa-039c-42f9-8dee-9c3f0009d61a> ; ga:publicationStatus "Reference Preview" ;
    ga:thisVersion <https://ekgf.github.io/grapharch/showcases/artifacts/dprod/specification/> ;
    ga:latestVersion <https://www.omg.org/spec/DPROD/> ;
    ga:editorDraft <https://github.com/EKGF/dprod> ;
    ga:license <https://creativecommons.org/licenses/by/4.0/> ;
    ga:copyright "DPROD sources: Copyright 2024–2026 Enterprise Knowledge Graph Forum, EDM Council, Inc. Grapharch-generated reference preview, CC BY 4.0." ;
    ga:metadataSource ex:collector:ontology ; ga:derivedMetadata ga:publicationDate .
ex:profile a ga:Profile ; ga:style "reader" .
ex:website a ga:Target ; dct:title "DPROD: ideas and guides" ;
    ga:scope ex:website-scope ; ga:profile ex:website-profile ;
    ga:renderer ga:WebsiteRenderer ; ga:destination "website" .
ex:website-scope a ga:Scope .
ex:website-profile a ga:Profile .
ex:pdf a ga:Target ; dct:title "DPROD ontology and SHACL reference — review edition" ;
    ga:scope ex:scope ; ga:profile ex:pdf-profile ;
    ga:renderer ga:TypstRenderer ; ga:destination "pdf" ; ga:publisher <urn:uuid:6c1408aa-039c-42f9-8dee-9c3f0009d61a> .
ex:pdf-profile a ga:Profile .

# Content collectors. Paths are relative to the pinned content tree.
ex:collector:abstract a ga:CollectorUse ; ga:collectorType ga:MarkdownFileCollector ;
    ga:source "abstract.md" ; ga:sourcePath "abstract.md" ; ga:fragment ex:fragment:abstract ; ga:includedIn ex:scope .
ex:collector:status a ga:CollectorUse ; ga:collectorType ga:MarkdownFileCollector ;
    ga:source "status.md" ; ga:sourcePath "status.md" ; ga:fragment ex:fragment:status ; ga:includedIn ex:scope .
ex:collector:overview a ga:CollectorUse ; ga:collectorType ga:MarkdownFileCollector ;
    ga:source "overview.md" ; ga:sourcePath "overview.md" ; ga:fragment ex:fragment:overview ; ga:includedIn ex:scope .
ex:collector:example a ga:CollectorUse ; ga:collectorType ga:MarkdownFileCollector ;
    ga:source "dataset-schema.md" ; ga:sourcePath "dataset-schema.md" ; ga:fragment ex:fragment:example ; ga:includedIn ex:scope .
ex:collector:ontology a ga:CollectorUse ; ga:collectorType ga:RdfFileCollector ;
    ga:source "ontology.ttl" ; ga:sourcePath "ontology.ttl" ; ga:subject <https://www.omg.org/spec/DPROD/dprod/> .
ex:collector:shapes a ga:CollectorUse ; ga:collectorType ga:RdfFileCollector ;
    ga:source "shapes.ttl" ; ga:sourcePath "shapes.ttl" ; ga:subject <https://www.omg.org/spec/DPROD/shapes/> .
ex:collector:website:index a ga:CollectorUse ; ga:collectorType ga:MarkdownPageCollector ;
    ga:source "website/index.md" ; ga:sourcePath "website/index.md" ; ga:fragment ex:fragment:website:index ;
    dct:title "DPROD" ; ga:route "" ; ga:includedIn ex:website-scope .
ex:collector:website:getting-started a ga:CollectorUse ; ga:collectorType ga:MarkdownPageCollector ;
    ga:source "website/guides/getting-started.md" ; ga:sourcePath "website/guides/getting-started.md" ; ga:fragment ex:fragment:website:getting-started ;
    dct:title "Getting started" ; ga:route "guides/getting-started/" ; ga:includedIn ex:website-scope .
ex:collector:website:stories a ga:CollectorUse ; ga:collectorType ga:MarkdownPageCollector ;
    ga:source "website/stories.md" ; ga:sourcePath "website/stories.md" ; ga:fragment ex:fragment:website:stories ;
    dct:title "Why a shared description matters" ; ga:route "stories/" ; ga:includedIn ex:website-scope .

# Generated vocabulary reference: authored sections select terms by type.
ex:reference a ga:DocumentorUse ; ga:documentorType ga:VocabularyReferenceDocumentor ;
    ga:subject <https://www.omg.org/spec/DPROD/dprod/> ; ga:includedIn ex:scope ;
    ga:referenceSection ex:section:classes, ex:section:object-properties, ex:section:datatype-properties, ex:section:annotation-properties, ex:section:named-individuals, ex:section:concept-schemes, ex:section:concepts, ex:section:node-shapes, ex:section:property-shapes .
ex:section:classes a ga:ReferenceSection ; ga:termType owl:Class ; ga:order 1 ; ga:component ex:component:classes .
ex:section:object-properties a ga:ReferenceSection ; ga:termType owl:ObjectProperty ; ga:order 2 ; ga:component ex:component:object-properties .
ex:section:datatype-properties a ga:ReferenceSection ; ga:termType owl:DatatypeProperty ; ga:order 3 ; ga:component ex:component:datatype-properties .
ex:section:annotation-properties a ga:ReferenceSection ; ga:termType owl:AnnotationProperty ; ga:order 4 ; ga:component ex:component:annotation-properties ; ga:definedTermsOnly true .
ex:section:named-individuals a ga:ReferenceSection ; ga:termType owl:NamedIndividual ; ga:order 5 ; ga:component ex:component:named-individuals ; ga:definedTermsOnly true .
ex:section:concept-schemes a ga:ReferenceSection ; ga:termType skos:ConceptScheme ; ga:order 6 ; ga:component ex:component:concept-schemes .
ex:section:concepts a ga:ReferenceSection ; ga:termType skos:Concept ; ga:order 7 ; ga:component ex:component:concepts ; ga:definedTermsOnly true .
ex:section:node-shapes a ga:ReferenceSection ; ga:termType sh:NodeShape ; ga:order 8 ; ga:component ex:component:node-shapes .
ex:section:property-shapes a ga:ReferenceSection ; ga:termType sh:PropertyShape ; ga:order 9 ; ga:component ex:component:property-shapes .

