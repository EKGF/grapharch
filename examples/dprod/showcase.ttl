# Exact-revision gallery build of EKGF/dprod: content from one designated
# commit, GraphArch definitions from one controlling commit. The gallery
# supplies the deployment URL; the definitions never declare it.
<urn:grapharch:showcase:dprod> a ga:Showcase ;
    ga:gitRepository "https://github.com/EKGF/dprod.git" ;
    ga:gitCommit "0620845e59e64b9a88461745b6bd7296b52ac5cc" ;
    ga:definitionsCommit "0620845e59e64b9a88461745b6bd7296b52ac5cc" ;
    ga:definitionsPath "publication/definitions/develop.ttl" ;
    ga:showcaseProject <urn:dprod-showcase:project> ;
    ga:allTargets true .

