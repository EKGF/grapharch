@prefix ga: <https://ekgf.org/ontology/grapharch#> .

# A TypeScript command-line package published with the zero-configuration
# defaults from one pinned commit. package.json names and versions the site;
# the guide index's link to it goes to the file in the repository.
<urn:grapharch:showcase:dr-ts-versioning> a ga:Showcase ;
    ga:gitRepository "https://github.com/legra-ai/dr-ts-versioning.git" ;
    ga:gitCommit "2249068ccef37e996e00a394e18c0ae9ac67b952" ;
    ga:materializedPath "README.md", "CHANGELOG.md", "LICENSE", "package.json",
        "docs/README.md",
        "docs/api-reference.md", "docs/changelog-generation.md",
        "docs/cli-usage.md", "docs/conventional-commits.md",
        "docs/development.md", "docs/formatting.md",
        "docs/markdown-formatting.md", "docs/versioning-system.md" ;
    ga:licensePath "LICENSE" .
