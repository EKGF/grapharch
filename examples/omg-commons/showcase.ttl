# The published OMG Commons ontologies, read from their authoritative URLs.
<urn:grapharch:showcase:commons> a ga:Showcase ;
    ga:definitionsPath "project.ttl" ;
    ga:showcaseProject <urn:omg-commons:project> ;
    ga:showcaseTargets ( <urn:omg-commons:specification> <urn:omg-commons:pdf> ) ;
