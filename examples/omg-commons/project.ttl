@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix gov: <https://ekgf.org/ontology/artifact-governance#> .
@prefix pub: <https://ekgf.org/ontology/artifact-publication#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <urn:omg-commons:> .

# Publication arrangement only. Ontology content is collected from OMG URLs.
ex:project a ga:Project; dct:title "OMG Commons Ontology Library"; ga:target ex:specification, ex:pdf .
ex:scope a ga:Scope .
ex:profile a ga:Profile; ga:style "omg"; pub:publishesFamily ex:family .
ex:family a gov:Family; rdfs:label "OMG Commons Ontology Library"; ga:collectionTerm "library" .
ex:specification a ga:Target; dct:title "OMG Commons Ontology Library";
    dct:description "A reference to the published Commons Ontology Library, including shared patterns for identifiers, organizations, roles, collections, dates, quantities and units.";
    rdfs:comment "An unofficial GraphArch documentation preview of the ontology documents published by OMG. This generated publication is not an approved OMG specification. Source annotations and licenses are preserved; external imports are not fetched and no reasoning is performed. Each build records the source URLs and content digests in its documentation graph.";
    ga:scope ex:scope; ga:profile ex:profile; ga:renderer <https://ekgf.org/ontology/grapharch#SpecificationPagesRenderer>; ga:destination "specification";
    ga:publisher ex:publisher; ga:publicationStatus "Documentation Preview";
    ga:publicationDate "2026-10-31"^^<http://www.w3.org/2001/XMLSchema#date>;
    ga:thisVersion <https://ekgf.github.io/grapharch/showcases/artifacts/commons/specification/>; ga:latestVersion <https://www.omg.org/spec/Commons>;
    ga:license <https://opensource.org/licenses/MIT> .
ex:pdf a ga:Target; dct:title "OMG Commons Ontology Library";
    dct:description "A reference to the published Commons Ontology Library, including shared patterns for identifiers, organizations, roles, collections, dates, quantities and units.";
    rdfs:comment "An unofficial GraphArch documentation preview of the ontology documents published by OMG. This generated publication is not an approved OMG specification. Source annotations and licenses are preserved; external imports are not fetched and no reasoning is performed. Each build records the source URLs and content digests in its documentation graph.";
    ga:scope ex:scope; ga:profile ex:profile; ga:renderer <https://ekgf.org/ontology/grapharch#SpecificationRenderer>; ga:destination "pdf";
    ga:publisher ex:publisher; ga:publicationStatus "Documentation Preview";
    ga:publicationDate "2026-10-31"^^<http://www.w3.org/2001/XMLSchema#date>;
    ga:thisVersion <https://ekgf.github.io/grapharch/showcases/artifacts/commons/specification/>; ga:latestVersion <https://www.omg.org/spec/Commons>;
    ga:license <https://opensource.org/licenses/MIT> .
ex:publisher a gov:Authority; rdfs:label "GraphArch showcases"; ga:shortName "GraphArch";
    ga:accentColor "#2b5f9f"; ga:url "https://ekgf.github.io/grapharch/" .

# Prefixes and ontology IRIs are those declared in OMG's RDF/XML documents.
<https://www.omg.org/spec/Commons/AboutCommons/> gov:inFamily ex:family; sh:declare [ sh:prefix "cmns-abt"; sh:namespace "https://www.omg.org/spec/Commons/AboutCommons/" ] .
<https://www.omg.org/spec/Commons/AnnotationVocabulary/> gov:inFamily ex:family; sh:declare [ sh:prefix "cmns-av"; sh:namespace "https://www.omg.org/spec/Commons/AnnotationVocabulary/" ] .
