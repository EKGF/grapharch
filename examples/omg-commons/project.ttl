# Publication arrangement of the Commons 1.3 edition. Ontology content is
# collected from OMG's versioned URLs; OMG's house style, boilerplate and logo
# are definitions of this consumer, not of the GraphArch engine.
ex:project a ga:Project; dct:title "Commons Ontology Library"; ga:target ex:specification, ex:pdf .
ex:scope a ga:Scope ; ga:include ex:edition .
ex:family a gov:Family; rdfs:label "OMG Commons Ontology Library"; ga:collectionTerm "library" .

# Formal OMG structure: no W3C abstract/status, family overview, coverage,
# quality or diagram notes; the ontologies are chapters of an authored clause.
ex:profile a ga:Profile; ga:theme omg:theme; pub:publishesFamily ex:family ;
    ga:w3cFrontMatter false ; ga:familyOverview false ; ga:coverageAppendix false ;
    ga:qualityAppendix false ; ga:diagramNote false ; ga:showProvenance false ;
    ga:familyPlacement ex:ontologies ; ga:familyBaseOrder 11 ;
    # The HTML reference opens with the library overview; the PDF omits it.
    ga:familyOverviewOrder 0 ;
    ga:requiredMetadataField "documentNumber", "latestVersion" ;
    ga:placement ex:preface, ex:ontologies, ex:deliverables .

