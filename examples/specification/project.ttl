@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix ex: <urn:specification:> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:project a ga:Project ; dct:title "Example Standards Group" ;
    ga:collector ex:collector ; ga:scope ex:scope ; ga:target ex:target .
ex:collector a ga:Collector ; ga:kind "rdf-file" ; ga:source "project.ttl" .
ex:scope a ga:Scope ; ga:include ex:subject .
ex:authored a ga:Contribution ; ga:processor ex:collector ; ga:project ex:project ;
    ga:source "project.ttl" ; ga:revision "specification-1" .
ex:target a ga:Target ; dct:title "Documentation Publication Model 1.0" ;
    ga:scope ex:scope ; ga:profile ex:profile ; ga:renderer "specification" ;
    ga:destination "specification" ;
    ga:publisher ex:publisher ; ga:publicationStatus "Editor's Draft" ;
    ga:publicationDate "2026-10-24"^^xsd:date ;
    ga:thisVersion <https://example.org/spec/2026-10-24/> ;
    ga:latestVersion <https://example.org/spec/> ;
    ga:editorDraft <https://example.org/spec/draft/> ;
    ga:editor ex:alex ;
    ga:license <https://creativecommons.org/licenses/by/4.0/> ;
    ga:copyright "Grapharch specification showcase." .
ex:publisher a ga:Authority ; dct:title "Enterprise Knowledge Graph Forum" ; ga:shortName "EKGF" ; ga:accentColor "#2b5f9f" ; ga:url "https://ekgf.org/" ; ga:logo "data:image/png;base64," .
ex:alex dct:title "Alex Example" ; ga:affiliation "Example Research Institute" ;
    ga:url "https://example.org/editors/alex" .
ex:profile a ga:Profile ; ga:placement ex:abstract, ex:status, ex:intro, ex:model, ex:changes, ex:references .
ex:abstract a ga:Placement ; ga:component ex:abstract-component ; ga:order 0 ; ga:sectionKind "abstract" .
ex:status a ga:Placement ; ga:component ex:status-component ; ga:order 1 ; ga:sectionKind "status" .
ex:intro a ga:Placement ; ga:component ex:intro-component ; ga:order 2 .
ex:model a ga:Placement ; ga:component ex:model-component ; ga:order 3 .
ex:changes a ga:Placement ; ga:component ex:changes-component ; ga:order 4 ; ga:sectionKind "appendix" .
ex:references a ga:Placement ; ga:component ex:references-component ; ga:order 5 ; ga:sectionKind "references" .
ex:abstract-component a ga:Component ; dct:title "Abstract" ; ga:fragment ex:abstract-body .
ex:status-component a ga:Component ; dct:title "Status of This Document" ; ga:fragment ex:status-body .
ex:intro-component a ga:Component ; dct:title "Introduction" ; ga:fragment ex:intro-body .
ex:model-component a ga:Component ; dct:title "Publication requirements" ; ga:fragment ex:model-body .
ex:changes-component a ga:Component ; dct:title "Change history" ; ga:fragment ex:changes-body .
ex:references-component a ga:Component ; dct:title "References" ; ga:fragment ex:references-body .
ex:abstract-body a ga:Fragment ; ga:subject ex:subject ; ga:format "text/markdown" ; ga:contribution ex:authored ;
    ga:body "This specification defines a model for publishing shared documentation fragments as independently arranged web specifications and review documents." .
ex:status-body a ga:Fragment ; ga:subject ex:subject ; ga:format "text/markdown" ; ga:contribution ex:authored ;
    ga:body "This illustrative draft demonstrates Grapharch publication. The publication metadata and all document content are read from the pinned documentation graph." .
ex:intro-body a ga:Fragment ; ga:subject ex:subject ; ga:format "text/markdown" ; ga:contribution ex:authored ;
    ga:body """A publication is a view of a validated documentation graph. Authors can maintain content independently of a particular output format.

## Data model

The model separates subjects, fragments, components, placements, and publication targets.

### Identity

A fragment retains its identity when reused in another publication. The string `<example>` is rendered as literal source text.

## Reading conventions

The key words **MUST**, **SHOULD**, and **MAY** in this illustrative document describe requirements on a publication implementation.
""" .
ex:model-body a ga:Fragment ; ga:subject ex:subject ; ga:format "text/markdown" ; ga:contribution ex:authored ;
    ga:body """A publisher **MUST** read a complete, validated graph revision. It **MUST NOT** publish partial collector contributions.

## Target bindings

| Binding | Purpose |
| --- | --- |
| Scope | Select documentable subjects |
| Profile | Arrange logical components |
| Renderer | Produce a publication format |

## Example

```turtle
<urn:example:target> <https://ekgf.org/ontology/grapharch#renderer> "specification" .
```
""" .
ex:changes-body a ga:Fragment ; ga:subject ex:subject ; ga:format "text/markdown" ; ga:contribution ex:authored ;
    ga:body "Initial illustrative draft demonstrating graph-backed specification publication." .
ex:references-body a ga:Fragment ; ga:subject ex:subject ; ga:format "text/markdown" ; ga:contribution ex:authored ;
    ga:body "- [RDF 1.1 Concepts and Abstract Syntax](https://www.w3.org/TR/rdf11-concepts/).\n- [Data Catalog Vocabulary (DCAT) - Version 3](https://www.w3.org/TR/vocab-dcat-3/)." .
