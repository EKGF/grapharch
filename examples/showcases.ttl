@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <urn:grapharch:showcase:> .
# Where the gallery deploys showcase artifacts; an exact-revision showcase is
# published beneath it at its slug, whatever its own definitions say.
<urn:grapharch:docs> ga:showcaseArtifactsUrl <https://ekgf.github.io/grapharch/showcases/artifacts/> .
<urn:grapharch:docs> ga:showcase ex:authored, ex:mixed, ex:specification, ex:dprod, ex:rdf12, ex:ekgf, ex:skos, ex:use-cases, ex:commons, ex:code-highlighting, ex:mkdocs-bootswatch, ex:fibo-be .
ex:authored a ga:Showcase ; ga:slug "authored" ; dct:title "One graph, three publications" ;
    dct:description "Shared fragments arranged as specification HTML, reader HTML, and a review PDF." ;
    ga:order 1 ; ga:showcaseRunner ga:AuthoredShowcaseRunner ; ga:source "showcase/project.ttl" ;
    ga:previewPath "reader/index.html" ; ga:pdfPath "review/document.pdf" .
ex:mixed a ga:Showcase ; ga:slug "mixed" ; dct:title "Markdown, SPARQL, and OWL" ;
    dct:description "Markdown tabs, callouts, tables and footnotes sit alongside native OWL definitions and a SPARQL example. One retained graph supplies the reader website and PDF." ;
    ga:order 2 ; ga:showcaseRunner ga:MixedSourcesShowcaseRunner ; ga:source "mixed-sources" ;
    ga:previewPath "website/index.html" ; ga:pdfPath "review/document.pdf" .
ex:specification a ga:Showcase ; ga:slug "specification" ; dct:title "Authority-branded specification" ;
    dct:description "Publication metadata, a numbered contents panel, references, and a matching PDF using EKGF branding." ;
    ga:order 3 ; ga:showcaseRunner ga:SpecificationShowcaseRunner ; ga:source "specification/project.ttl" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "specification/document.pdf" .
ex:rdf12 a ga:Showcase ; ga:slug "rdf12" ; dct:title "W3C RDF 1.2 N-Triples" ;
    dct:description "A W3C specification published from its original HTML, preserving document structure and cross-references. A known broken source link is explained in the generated issue report." ;
    ga:order 5 ; ga:showcaseRunner ga:W3cSpecificationShowcaseRunner ; ga:source "w3c-rdf12-n-triples" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "specification/document.pdf" ;
    ga:expectedDiagnostic "unresolved-native-reference" .
ex:dprod a ga:Showcase ; ga:slug "dprod" ; dct:title "DPROD: native ontology and SHACL" ;
    dct:description "A pinned DPROD working-draft revision becomes a standards reference, companion guide, an EKGF community PDF and an OMG submission-preview PDF. Both specification editions share the same technical chapters; a separate illustrated overview explains the bigger picture and adoption path. All outputs retain the pinned source revision." ;
    ga:order 4 ; ga:showcaseRunner ga:RevisionBuildShowcaseRunner ; ga:source "dprod/showcase.ttl" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "pdf/ekgf/document.pdf" .

# TEMPORARY PIN until the EKG migration lands upstream: ekg-ontologies main emits
# relative links the gallery guard rejects, so the showcase reads commit 6bd93ab,
# which publishes only spec/develop. Restore the default branch, spec/main and
# documents/main/document.pdf then (see ekg-ontologies/showcase.yaml).
ex:ekgf a ga:Showcase ; ga:slug "ekgf" ; dct:title "EKGF ontology family" ;
    dct:description "A pinned commit of a remote ontology repository becomes a registered family reference, with cross-ontology links, governance authority roles, and concrete Git commit provenance." ;
    ga:order 6 ; ga:showcaseRunner ga:OntologyFamilyShowcaseRunner ; ga:source "ekg-ontologies/showcase.ttl" ;
    ga:previewPath "spec/develop/index.html" .

ex:skos a ga:Showcase;ga:slug "skos";dct:title "SKOS business data taxonomy";
 dct:description "A native concept scheme, multilingual labels, hierarchy and mapping links, and ordered collection membership become a specification and PDF.";
 ga:order 7;ga:showcaseRunner ga:SkosShowcaseRunner;ga:source "skos";
 ga:previewPath "specification/index.html";ga:pdfPath "specification/document.pdf" .
ex:use-cases a ga:Showcase;ga:slug "use-cases";dct:title "EKGF use-case trees";
 dct:description "Actual RDF use-case instances, ownership and reuse links, personas and outcomes, with KG-generated neighborhood diagrams and a review PDF.";
 ga:order 8;ga:showcaseRunner ga:UseCasesShowcaseRunner;ga:source "use-cases";
 ga:previewPath "website/index.html";ga:pdfPath "review/document.pdf" .

ex:commons a ga:Showcase; ga:slug "commons"; dct:title "OMG Commons Ontology Library";
    dct:description "The published OMG Commons ontologies are collected directly from their authoritative RDF URLs and become a library overview, an individual specification page per ontology, and a PDF, with native terms and source content digests.";
    ga:order 9; ga:showcaseRunner ga:OntologyFamilyShowcaseRunner; ga:source "omg-commons/showcase.ttl";
    ga:previewPath "specification/index.html"; ga:pdfPath "pdf/document.pdf" .

ex:code-highlighting a ga:Showcase ; ga:slug "code-highlighting" ; dct:title "Multilingual code examples" ;
    dct:description "Python, Bash, JavaScript, TypeScript, JSON, JSON-LD and SPARQL examples share offline syntax colours in the specification and PDF, with source text retained in the documentation graph." ;
    ga:order 10 ; ga:showcaseRunner ga:SpecificationShowcaseRunner ; ga:source "code-highlighting/project.ttl" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "specification/document.pdf" .

# Gallery discovery describes demonstrated capabilities; output formats are
# derived from retained publication artifacts instead of duplicated here.
ex:authored ga:showcaseInput "RDF" ; ga:showcaseCapability "Multiple editions", "Shared content" ; ga:showcaseUseCase "Multi-output publishing" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/showcase> ; dct:rights "Authored GraphArch example maintained by EKGF. Source and license are available in the repository." .
ex:mixed ga:showcaseInput "Markdown", "SPARQL", "OWL" ; ga:showcaseCapability "Cross-references", "Mixed sources", "Tabs", "Callouts", "Footnotes", "Tables" ; ga:showcaseUseCase "Documentation site" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/mixed-sources> ; dct:rights "Authored GraphArch example maintained by EKGF. Source and license are available in the repository." .
ex:specification ga:showcaseInput "RDF" ; ga:showcaseCapability "Authority branding", "Cross-references" ; ga:showcaseUseCase "Standards publication" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/specification> ; dct:rights "Authored GraphArch example maintained by EKGF. This demonstrates publication styling, not an adopted standard." .
ex:dprod ga:showcaseInput "OWL", "SHACL" ; ga:showcaseCapability "Diagrams", "Multiple editions", "Cross-references" ; ga:showcaseUseCase "Ontology reference", "Standards publication" ; dct:source <https://github.com/EKGF/dprod> ; dct:rights "DPROD workgroup, EKGF and OMG contributors. Each generated publication records its collected source revision and applicable credits." .
ex:rdf12 ga:showcaseInput "HTML" ; ga:showcaseCapability "Cross-references", "Source issue reporting" ; ga:showcaseUseCase "Standards publication" ; dct:source <https://www.w3.org/TR/rdf12-n-triples/> ; dct:rights "W3C RDF 1.2 N-Triples contributors. W3C Software and Document Notice and License; original attribution is retained in the publication." .
ex:ekgf ga:showcaseInput "OWL" ; ga:showcaseCapability "Diagrams", "Cross-references", "Ontology families" ; ga:showcaseUseCase "Ontology reference" ; dct:source <https://github.com/EKGF/ekg-ontologies> ; dct:rights "EKGF ontology contributors. The collected Git revision is recorded in the generated publication." .
ex:skos ga:showcaseInput "SKOS" ; ga:showcaseCapability "Multilingual labels", "Hierarchies", "Cross-references" ; ga:showcaseUseCase "Taxonomy reference" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/skos> ; dct:rights "Authored GraphArch taxonomy example maintained by EKGF. Source and license are available in the repository." .
ex:use-cases ga:showcaseInput "RDF" ; ga:showcaseCapability "Diagrams", "Hierarchies", "Cross-references" ; ga:showcaseUseCase "Use-case catalog" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/use-cases> ; dct:rights "EKGF use-case example. Source provenance is retained with the generated diagrams and publications." .
ex:commons ga:showcaseInput "OWL", "RDF/XML" ; ga:showcaseCapability "Diagrams", "Ontology families", "Cross-references" ; ga:showcaseUseCase "Ontology reference" ; dct:source <https://www.omg.org/spec/Commons/> ; dct:rights "OMG Commons Ontology Library contributors. Original ontology notices, authoritative source URLs and content digests are retained." .
ex:code-highlighting ga:showcaseInput "Markdown" ; ga:showcaseCapability "Syntax highlighting" ; ga:showcaseUseCase "Technical documentation" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/code-highlighting> ; dct:rights "Authored GraphArch code samples maintained by EKGF. Source and license are available in the repository." .

ex:mkdocs-bootswatch a ga:Showcase ; ga:slug "mkdocs-bootswatch" ;
    dct:title "Independent MkDocs documentation" ;
    dct:description "The original MkDocs Bootswatch documentation, including its theme screenshots, imported from a pinned Git revision without running MkDocs. GraphArch supplies navigation, search, HTML and a retained documentation graph; the original BSD license remains downloadable." ;
    ga:order 11 ; ga:showcaseRunner ga:MkdocsShowcaseRunner ; ga:source "mkdocs-bootswatch/showcase.ttl" ;
    ga:previewPath "site/index.html" ;
    ga:showcaseInput "Markdown", "MkDocs" ;
    ga:showcaseCapability "Navigation", "Images", "Search" ;
    ga:showcaseUseCase "Documentation site" ;
    dct:source <https://github.com/mkdocs/mkdocs-bootswatch> ;
    dct:rights "MkDocs Bootswatch Themes by Tom Christie and Dougal Matthews, BSD 2-Clause license. This is a GraphArch rendering of the original documentation, not a reproduction of its Bootstrap theme runtime." .

ex:fibo-be a ga:Showcase; ga:slug "fibo-be"; dct:title "FIBO Business Entities";
 dct:description "The complete 48-document FIBO BE domain, including legal entities, ownership, corporations, governments and regional reference individuals. A pinned official revision becomes a paginated ontology reference, UML class diagrams and PDF; imports outside BE remain explicit external references.";
 ga:order 12; ga:showcaseRunner ga:OntologyFamilyShowcaseRunner; ga:source "fibo-be/showcase.ttl";
 ga:previewPath "specification/index.html"; ga:pdfPath "pdf/document.pdf";
 ga:showcaseInput "OWL", "RDF/XML";
 ga:showcaseCapability "Diagrams", "Ontology families", "Cross-references";
 ga:showcaseUseCase "Ontology reference", "Business vocabulary";
 dct:source <https://github.com/edmcouncil/fibo/tree/33a92cd34285d532c158da97bb42add089f135d3/BE>;
 dct:rights "FIBO Business Entities by EDM Council and its contributors, MIT license. The source ontologies retain their EDM Council and OMG copyright notices. This unofficial GraphArch preview records immutable source URLs and content digests." .

ex:commons dct:abstract "The library collects the published ontologies directly from OMG RDF URLs. Its overview links to a specification for each ontology, with a combined PDF and exported KG. Unlike Git repository examples, source revisions are identified by URL and content digest." .

ex:fibo-be dct:abstract "All 48 RDF/XML documents in the official Business Entities module are collected at an immutable repository revision: legal entities, corporations, ownership, partnerships, trusts and regional reference individuals. The source-owned module hierarchy organizes the HTML pages and combined PDF. Imports outside BE remain explicit external references; the linked source inventory records the exact revision, license and boundaries." .

ex:mkdocs-bootswatch dct:abstract "The original MkDocs Bootswatch Themes sources are imported at an immutable Git revision, including twenty screenshots and the original BSD license. Navigation and search work without executing MkDocs or its theme plugins. HTML and the retained graph are provided; this website example does not advertise a PDF." .

ex:code-highlighting dct:abstract "Python, Bash, JavaScript, TypeScript, JSON, JSON-LD and SPARQL examples use the same offline syntax colours in HTML and PDF. The Code examples and syntax colours guide explains fence names and practical Markdown examples." .

ex:dprod dct:abstract "The EKGF community and OMG submission-preview PDF editions share the same pinned repository revision and technical chapters. Publication profiles select different front matter and publisher branding. The submission preview does not claim OMG approval or an assigned OMG document number. A separate illustrated overview explains the bigger picture and adoption path." .
