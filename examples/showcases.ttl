@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <urn:grapharch:showcase:> .
<urn:grapharch:docs> ga:showcase ex:authored, ex:mixed, ex:specification, ex:dprod, ex:rdf12, ex:ekgf, ex:skos, ex:use-cases, ex:commons, ex:code-highlighting .
ex:authored a ga:Showcase ; ga:slug "authored" ; dct:title "One graph, three publications" ;
    dct:description "Shared fragments arranged as specification HTML, reader HTML, and a review PDF." ;
    ga:order 1 ; ga:kind "authored" ; ga:source "showcase/project.ttl" ;
    ga:previewPath "reader/index.html" ; ga:pdfPath "review/document.pdf" .
ex:mixed a ga:Showcase ; ga:slug "mixed" ; dct:title "Markdown, SPARQL, and OWL" ;
    dct:description "Specialized collectors and an ontology documentor turn native inputs into a reader website and PDF." ;
    ga:order 2 ; ga:kind "mixed" ; ga:source "mixed-sources" ;
    ga:previewPath "website/index.html" ; ga:pdfPath "review/document.pdf" .
ex:specification a ga:Showcase ; ga:slug "specification" ; dct:title "Authority-branded specification" ;
    dct:description "Publication metadata, a numbered contents panel, references, and a matching PDF using EKGF branding." ;
    ga:order 3 ; ga:kind "specification" ; ga:source "specification/project.ttl" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "specification/document.pdf" .
ex:rdf12 a ga:Showcase ; ga:slug "rdf12" ; dct:title "W3C RDF 1.2 N-Triples" ;
    dct:description "A W3C specification published from its original HTML, preserving document structure and cross-references. A known broken source link is explained in the generated issue report." ;
    ga:order 5 ; ga:kind "w3c" ; ga:source "w3c-rdf12-n-triples" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "specification/document.pdf" ;
    ga:expectedDiagnostic "unresolved-native-reference" .
ex:dprod a ga:Showcase ; ga:slug "dprod" ; dct:title "DPROD: native ontology and SHACL" ;
    dct:description "DPROD from the develop branch becomes a standards reference, companion guide, an EKGF community PDF and an OMG submission-preview PDF. Both specification editions share the same technical chapters; a separate illustrated overview explains the bigger picture and adoption path. All outputs retain the pinned source revision." ;
    ga:order 4 ; ga:kind "dprod" ; ga:source "dprod/live.yaml" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "pdf/ekgf/document.pdf" .

ex:ekgf a ga:Showcase ; ga:slug "ekgf" ; dct:title "EKGF ontology family" ;
    dct:description "The latest default branch of a remote ontology repository becomes a registered family reference, with cross-ontology links, governance authority roles, and concrete Git commit provenance." ;
    ga:order 6 ; ga:kind "ontology-family" ; ga:source "ekg-ontologies/showcase.yaml" .

ex:skos a ga:Showcase;ga:slug "skos";dct:title "SKOS business data taxonomy";
 dct:description "A native concept scheme, multilingual labels, hierarchy and mapping links, and ordered collection membership become a specification and PDF.";
 ga:order 7;ga:kind "skos";ga:source "skos";
 ga:previewPath "specification/index.html";ga:pdfPath "specification/document.pdf" .
ex:use-cases a ga:Showcase;ga:slug "use-cases";dct:title "EKGF use-case trees";
 dct:description "Actual RDF use-case instances, ownership and reuse links, personas and outcomes, with KG-generated neighborhood diagrams and a review PDF.";
 ga:order 8;ga:kind "use-cases";ga:source "use-cases";
 ga:previewPath "website/index.html";ga:pdfPath "review/document.pdf" .

ex:commons a ga:Showcase; ga:slug "commons"; dct:title "OMG Commons Ontology Library";
    dct:description "The published OMG Commons ontologies are collected directly from their authoritative RDF URLs and become a library overview, an individual specification page per ontology, and a PDF, with native terms and source content digests.";
    ga:order 9; ga:kind "ontology-family"; ga:source "omg-commons/showcase.yaml";
    ga:previewPath "specification/index.html"; ga:pdfPath "pdf/document.pdf" .

ex:code-highlighting a ga:Showcase ; ga:slug "code-highlighting" ; dct:title "Multilingual code examples" ;
    dct:description "Python, Bash, JavaScript, TypeScript, JSON, JSON-LD and SPARQL examples share offline syntax colours in the specification and PDF, with source text retained in the documentation graph." ;
    ga:order 10 ; ga:kind "specification" ; ga:source "code-highlighting/project.ttl" ;
    ga:previewPath "specification/index.html" ; ga:pdfPath "specification/document.pdf" .

# Gallery discovery describes demonstrated capabilities; output formats are
# derived from retained publication artifacts instead of duplicated here.
ex:authored ga:showcaseInput "RDF" ; ga:showcaseCapability "Multiple editions", "Shared content" ; ga:showcaseUseCase "Multi-output publishing" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/showcase> ; dct:rights "Authored GraphArch example maintained by EKGF. Source and license are available in the repository." .
ex:mixed ga:showcaseInput "Markdown", "SPARQL", "OWL" ; ga:showcaseCapability "Cross-references", "Mixed sources" ; ga:showcaseUseCase "Documentation site" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/mixed-sources> ; dct:rights "Authored GraphArch example maintained by EKGF. Source and license are available in the repository." .
ex:specification ga:showcaseInput "RDF" ; ga:showcaseCapability "Authority branding", "Cross-references" ; ga:showcaseUseCase "Standards publication" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/specification> ; dct:rights "Authored GraphArch example maintained by EKGF. This demonstrates publication styling, not an adopted standard." .
ex:dprod ga:showcaseInput "OWL", "SHACL" ; ga:showcaseCapability "Diagrams", "Multiple editions", "Cross-references" ; ga:showcaseUseCase "Ontology reference", "Standards publication" ; dct:source <https://github.com/EKGF/dprod> ; dct:rights "DPROD workgroup, EKGF and OMG contributors. Each generated publication records its collected source revision and applicable credits." .
ex:rdf12 ga:showcaseInput "HTML" ; ga:showcaseCapability "Cross-references", "Source issue reporting" ; ga:showcaseUseCase "Standards publication" ; dct:source <https://www.w3.org/TR/rdf12-n-triples/> ; dct:rights "W3C RDF 1.2 N-Triples contributors. W3C Software and Document Notice and License; original attribution is retained in the publication." .
ex:ekgf ga:showcaseInput "OWL" ; ga:showcaseCapability "Diagrams", "Cross-references", "Ontology families" ; ga:showcaseUseCase "Ontology reference" ; dct:source <https://github.com/EKGF/ekg-ontologies> ; dct:rights "EKGF ontology contributors. The collected Git revision is recorded in the generated publication." .
ex:skos ga:showcaseInput "SKOS" ; ga:showcaseCapability "Multilingual labels", "Hierarchies", "Cross-references" ; ga:showcaseUseCase "Taxonomy reference" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/skos> ; dct:rights "Authored GraphArch taxonomy example maintained by EKGF. Source and license are available in the repository." .
ex:use-cases ga:showcaseInput "RDF" ; ga:showcaseCapability "Diagrams", "Hierarchies", "Cross-references" ; ga:showcaseUseCase "Use-case catalog" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/use-cases> ; dct:rights "EKGF use-case example. Source provenance is retained with the generated diagrams and publications." .
ex:commons ga:showcaseInput "OWL", "RDF/XML" ; ga:showcaseCapability "Diagrams", "Ontology families", "Cross-references" ; ga:showcaseUseCase "Ontology reference" ; dct:source <https://www.omg.org/spec/Commons/> ; dct:rights "OMG Commons Ontology Library contributors. Original ontology notices, authoritative source URLs and content digests are retained." .
ex:code-highlighting ga:showcaseInput "Markdown" ; ga:showcaseCapability "Syntax highlighting" ; ga:showcaseUseCase "Technical documentation" ; dct:source <https://github.com/EKGF/grapharch/tree/main/examples/code-highlighting> ; dct:rights "Authored GraphArch code samples maintained by EKGF. Source and license are available in the repository." .
