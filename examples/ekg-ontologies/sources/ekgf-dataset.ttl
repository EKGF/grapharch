@base <https://ekgf.org/ontology/dataset#> .

: rdf:type owl:Ontology ;
  sh:declare [
      sh:prefix "ekg-dataset" ;
      sh:namespace "https://ekgf.org/ontology/dataset#"^^xsd:anyURI
  ] ;
    owl:imports <http://www.w3.org/ns/dcat> ;
    rdfs:comment "A vocabulary for RDF datasets and their source files, named graphs, identifiers, and composition into static or compound datasets."@en ;
    rdfs:label "EKGF Dataset Ontology"@en .

