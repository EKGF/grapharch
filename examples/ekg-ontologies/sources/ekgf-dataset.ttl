<http://purl.org/dc/elements/1.1/date> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://ekgf.org/ontology/dataset#includesDataset
:includesDataset rdf:type owl:ObjectProperty ;
    rdfs:domain :CompoundDataset ;
    rdfs:range :Dataset .


###  https://ekgf.org/ontology/dataset#defaultGraph
:defaultGraph rdf:type owl:ObjectProperty ;
    rdfs:domain :Dataset ;
    rdfs:comment "The named graph that the files of the dataset are loaded into."@en ;
    rdfs:label "default graph"@en .


#################################################################
#    Data properties
#################################################################

###  https://ekgf.org/ontology/dataset#datasetCode
:datasetCode rdf:type
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:comment
        "The datasetCode is a lowercase short unique name for the given dataset that is being used as the default (local) name for the named graph that holds the Dataset or the Pipeline that creates the dataset and for logging purposes to identify the Dataset."@en ;
    rdfs:label "Dataset Code"@en .

###  https://ekgf.org/ontology/dataset#dataSourceCode
:dataSourceCode rdf:type
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:comment
        "The dataSourceCode is a lowercase short unique name for the given data source that is being used as the default (local) name for the named graph that holds the data source for logging purposes to identify the data source."@en ;
    rdfs:label "Data Source Code"@en .


###  https://ekgf.org/ontology/dataset#include
:include rdf:type owl:DatatypeProperty ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string ;
    rdfs:comment "Path of an RDF file that belongs to the dataset."@en ;
    rdfs:label "include"@en .


#################################################################
#    Classes
#################################################################

###  https://ekgf.org/ontology/dataset#CompoundDataset
:CompoundDataset rdf:type owl:Class ;
    rdfs:subClassOf :Dataset ;
    rdfs:comment "A CompoundDataset is a Dataset that is dynamically composed of multiple other Datasets"@en .


###  https://ekgf.org/ontology/dataset#Dataset
:Dataset rdf:type owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/dcat#Dataset> ;
    <http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
    <http://purl.org/dc/elements/1.1/date> "2020-04-24T12:34:37Z"^^xsd:dateTime ;
    rdfs:comment "An organized collection of RDF data described with source-file and graph metadata. The class specializes dcat:Dataset and can be static or composed of other datasets."@en ;
    rdfs:label "Dataset"@en .


###  https://ekgf.org/ontology/dataset#NamedGraph
:NamedGraph rdf:type owl:Class .


###  https://ekgf.org/ontology/dataset#StaticDataset
:StaticDataset rdf:type owl:Class ;
    rdfs:subClassOf :Dataset ;
    <http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
    <http://purl.org/dc/elements/1.1/date> "2020-04-24T12:35:33Z"^^xsd:dateTime ;
    rdfs:comment "A Static EKG Dataset is a git-based RDF Dataset that is not produced by a DataOps pipeline"@en .


