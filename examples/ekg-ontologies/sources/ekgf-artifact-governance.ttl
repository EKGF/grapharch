    rdfs:comment "A standards-community participation role for editing the content of standards and their supporting artifacts."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/artifact-governance#> .

<https://ekgf.org/ontology/artifact-governance#StandardsPublisherRole>
    rdfs:comment "A standards-community participation role for publishing standards artifacts and releases."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/artifact-governance#> .

<https://ekgf.org/ontology/artifact-governance#StandardsReviewerRole>
    rdfs:comment "A standards-community participation role for reviewing standards content and proposed changes."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/artifact-governance#> .

<https://ekgf.org/ontology/artifact-governance#StandardsStaffRole>
    rdfs:comment "A standards-community participation role for staff supporting the operation of the standards community."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/artifact-governance#> .

<https://ekgf.org/ontology/artifact-governance#WorkingGroupChairRole>
