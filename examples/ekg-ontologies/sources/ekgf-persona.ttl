<https://ekgf.org/ontology/persona#>
    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://ekgf.org/ontology/persona#Accountability>
    rdfs:label "Accountability"@en ;
    rdfs:comment "A responsibility or expected area of ownership assigned to a persona."@en .

<https://ekgf.org/ontology/persona#Persona>
    rdfs:label "Persona"@en ;
    rdfs:comment "A role-oriented description of the actor who participates in a story or carries an accountability in the EKG method. It is not an identity record for an individual person."@en .

<https://ekgf.org/ontology/persona#accountability>
    rdfs:comment "Relates a persona to an accountability assigned to it."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/persona#> .

<https://ekgf.org/ontology/persona#isSubPersonaOf>
    rdfs:label "Is Sub Persona Of"@en ;
    rdfs:comment "Relates a more specific persona to a broader persona. Its irreflexive axiom excludes a persona being its own sub-persona."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/persona#> .

<https://ekgf.org/ontology/persona#key>
    rdfs:label "Persona key"@en ;
    rdfs:comment "Records the string key used to identify a persona within an application or configuration. Functionality limits a persona to one value; it does not assert global uniqueness."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/persona#> .
