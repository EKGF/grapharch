persona: rdf:type owl:Ontology ;
  sh:declare [
      sh:prefix "ekg-persona" ;
      sh:namespace "https://ekgf.org/ontology/persona#"^^xsd:anyURI
  ] ;
                                      rdfs:comment "A vocabulary for personas participating in EKG stories, their accountabilities, and sub-persona relationships. Persona identities are distinct from individual people."@en ;
                                      rdfs:label "EKGF Persona Ontology"@en .

