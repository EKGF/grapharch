#    Documentation annotations
#################################################################

<https://ekgf.org/ontology/dataops#>
    rdfs:comment "A vocabulary for DataOps pipelines, RDF load requests, their processing states, and the single-graph and multi-graph datasets produced during loading and assembly."@en ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://ekgf.org/ontology/dataops#FailedLoadRequest>
    rdfs:comment "A load request classified as failed because its loading operation did not complete successfully."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#FinishedLoadRequest>
    rdfs:comment "A load request classified as finished after its loading operation has completed."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#LoadRequest>
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#LoadingLoadRequest>
    rdfs:comment "A load request whose loading operation is in progress."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#MultiGraphDataset>
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#Pipeline>
    rdfs:label "Pipeline"@en ;
    rdfs:comment "A DataOps process in which load requests bring source data into datasets and subsequent steps can assemble or transform that data."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#QueuedLoadRequest>
    rdfs:comment "A load request waiting to be processed by a pipeline."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#SingleGraphDataset>
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#createdByPipeline>
    rdfs:label "Created By Pipeline"@en ;
    rdfs:comment "Identifies the DataOps pipeline that produced a dataset."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#graph>
    rdfs:comment "Records the IRI of the target graph for a load request as an xsd:anyURI literal."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#inPipeline>
    rdfs:label "In Pipeline"@en ;
    rdfs:comment "Identifies the pipeline to which a load request belongs. Each load request has at most one pipeline under the declared functional-property axiom."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#loadedByLoadRequest>
    rdfs:label "Loaded By Load Request"@en ;
    rdfs:comment "Relates a single-graph dataset to a load request that loaded its data."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .

<https://ekgf.org/ontology/dataops#source>
    rdfs:comment "Records the IRI of the source to be loaded by a load request as an xsd:anyURI literal."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/dataops#> .
