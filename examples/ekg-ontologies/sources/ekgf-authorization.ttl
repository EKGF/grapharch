@prefix : <https://ekgf.org/ontology/authorization#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix authorization: <https://ekgf.org/ontology/authorization#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ekg-authorization: <https://ekgf.org/ontology/authorization#> .
@base <https://ekgf.org/ontology/authorization#> .

authorization: rdf:type owl:Ontology ;
  sh:declare [
      sh:prefix "ekg-authorization" ;
      sh:namespace "https://ekgf.org/ontology/authorization#"^^xsd:anyURI
  ] ;
    owl:imports <https://ekgf.org/ontology/persona#> ;
    rdfs:comment
        """The EKGF Authorization Ontology.

       Modeling \"Role Based Access Control\" which is not the same
       as EKG-level entitlement calculation but could be part thereof."""@en ;
    rdfs:label
        "EKGF Authorisation Ontology"@en,
        "EKGF Authorization Ontology"@en-us .

#################################################################
#    Object Properties
#################################################################

###  https://ekgf.org/ontology/authorization#hasGroup
authorization:hasGroup rdf:type owl:ObjectProperty ;
    rdfs:domain authorization:AuthorizationRule ;
    rdfs:range authorization:AuthorizationGroup .


###  https://ekgf.org/ontology/authorization#hasPersona
authorization:hasPersona rdf:type owl:ObjectProperty ;
    rdfs:domain authorization:AuthorizationRule ;
    rdfs:range <https://ekgf.org/ontology/persona#Persona> .


#################################################################
#    Classes
#################################################################

###  https://ekgf.org/ontology/authorization#AuthorizationGroup
authorization:AuthorizationGroup rdf:type owl:Class .


###  https://ekgf.org/ontology/authorization#AuthorizationRule
authorization:AuthorizationRule rdf:type owl:Class .


