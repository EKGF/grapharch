<https://ekgf.org/ontology/authorization#>
    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://ekgf.org/ontology/authorization#AuthorizationGroup>
    rdfs:label "Authorization Group"@en ;
    rdfs:comment "A grouping used by authorization rules to express role-based access-control requirements. It is distinct from a persona and does not by itself calculate EKG-wide entitlements."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/authorization#> .

<https://ekgf.org/ontology/authorization#AuthorizationRule>
    rdfs:label "Authorization Rule"@en ;
    rdfs:comment "A rule associating authorization groups with personas in the role-based access-control model. The vocabulary records these relationships without defining a rule evaluation algorithm."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/authorization#> .

<https://ekgf.org/ontology/authorization#hasGroup>
    rdfs:label "Has Group"@en ;
    rdfs:comment "Associates an authorization rule with an authorization group participating in that rule."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/authorization#> .

<https://ekgf.org/ontology/authorization#hasPersona>
    rdfs:label "Has Persona"@en ;
    rdfs:comment "Associates an authorization rule with a persona to which the rule relates."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/authorization#> .
