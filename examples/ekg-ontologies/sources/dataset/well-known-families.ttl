# ── DASH ─────────────────────────────────────────────────────

<urn:uuid:89384eba-df36-4e6a-9d50-3fa8e96b32a1>
    rdf:type artgov:Family ;
    rdfs:label "DASH Data Shapes Vocabulary"@en ;
    rdfs:comment "DASH is a SHACL library for frequently needed features and design patterns."@en ;
    artgov:familyAcronym "DASH" ;
