@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix api: <https://ekgf.org/ontology/api#> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix artgov: <https://ekgf.org/ontology/artifact-governance#> .

#
# The well-known authorities.
#
# This file is the registry of authority identities. Each IRI is a random
# UUIDv4 URN, minted once and reused regardless of names, hosts or URLs.
# An authority may have multiple hosts. To mint a new identity:
#
#   python3 -c "import uuid; print(uuid.uuid4().urn)"
#
# Check existing entries before minting. A domain change does not create
# a new authority. Organizations have separate UUIDv4 identities in
# well-known-organizations.ttl; cmns-rlcmp:isPlayedBy links a role to its player.
#
# Every authority that governs an ontology, a shapeset or a taxonomy is
# declared here and nowhere else.
#

# ── W3C ──────────────────────────────────────────────────────

<urn:uuid:3129ef76-7e6d-48d4-92c2-4fe98c9621ce>
    rdf:type artgov:Authority ;
    cmns-rlcmp:isPlayedBy <urn:uuid:96c6206b-38fb-4625-a784-de7903329897> ;
    api:slug "w3c" ;
    rdfs:label "W3C"@en ;
    artgov:authorityAcronym "W3C" ;
    artgov:authorityHost "www.w3.org" ;
    artgov:baseIri "http://www.w3.org"^^xsd:anyURI ;
    artgov:autoLoad false .

