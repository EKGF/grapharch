@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix artgov: <https://ekgf.org/ontology/artifact-governance#> .

# Registry of organizations that play authority roles or host communities.
# Mint each UUIDv4 URN once and reuse it when names or websites change.
# Multiple websites are permitted. Reuse an existing organization when it
# plays another authority role. Authority roles have separate identities in
# well-known-authorities.ttl.
#
#   python3 -c "import uuid; print(uuid.uuid4().urn)"

<urn:uuid:96c6206b-38fb-4625-a784-de7903329897>
    rdf:type cmns-org:Organization , cmns-org:LegalEntity ;
    rdfs:label "World Wide Web Consortium (W3C)"@en ;
    artgov:organizationCategory artgov:StandardsBodyCategory , artgov:ConsortiumCategory ;
    cmns-org:hasWebsite "https://www.w3.org/"^^xsd:anyURI ;
    rdfs:seeAlso <https://www.w3.org/about/> .

