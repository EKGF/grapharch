# 
# https://ekgf.org/ontology/story#hasInputConcept

:hasInputConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:DataElementConcept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Direct projection of the input concepts required by the Story."@en ;
	rdfs:label "has input concept"@en .
# 
# https://ekgf.org/ontology/story#hasOutputConcept

:hasOutputConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:DataElementConcept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Direct projection of the output concepts produced by the Story."@en ;
	rdfs:label "has output concept"@en .
# 
