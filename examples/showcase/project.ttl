@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix ex: <urn:showcase:> .
@prefix dct: <http://purl.org/dc/terms/> .

ex:project a ga:Project ; dct:title "Grapharch documentation graph" ;
    ga:collector ex:collector ; ga:scope ex:scope ; ga:target ex:spec, ex:reader, ex:pdf .
ex:collector a ga:Collector ; ga:kind "rdf-file" ; ga:source "project.ttl" .
ex:scope a ga:Scope ; ga:include ex:overview, ex:contract, ex:glossary, ex:references .
ex:authored a ga:Contribution ; ga:processor ex:collector ; ga:project ex:project ;
    ga:source "project.ttl" ; ga:revision "showcase-1" .
ex:spec a ga:Target ; dct:title "Documentation graph specification" ; ga:scope ex:scope ;
    ga:profile ex:spec-profile ; ga:renderer "html" ; ga:destination "specification" .
ex:reader a ga:Target ; dct:title "A guide to the documentation graph" ; ga:scope ex:scope ;
    ga:profile ex:reader-profile ; ga:renderer "html" ; ga:destination "reader" .
ex:pdf a ga:Target ; dct:title "Documentation graph - review draft" ; ga:scope ex:scope ;
    ga:profile ex:spec-profile ; ga:renderer "typst" ; ga:destination "review" .
ex:spec-profile a ga:Profile ; ga:style "specification" ;
    ga:placement ex:spec-overview, ex:spec-contract, ex:spec-glossary, ex:spec-references .
ex:reader-profile a ga:Profile ; ga:style "reader" ;
    ga:placement ex:reader-overview, ex:reader-glossary, ex:reader-references, ex:reader-contract .
ex:spec-overview a ga:Placement ; ga:component ex:overview-component ; ga:order 1 ; ga:sectionKind "section" .
ex:spec-contract a ga:Placement ; ga:component ex:contract-component ; ga:order 2 ; ga:sectionKind "appendix" .
ex:spec-glossary a ga:Placement ; ga:component ex:glossary-component ; ga:order 3 ; ga:sectionKind "glossary" .
ex:spec-references a ga:Placement ; ga:component ex:references-component ; ga:order 4 ; ga:sectionKind "references" .
ex:reader-overview a ga:Placement ; ga:component ex:overview-component ; ga:order 1 ; ga:sectionKind "section" .
ex:reader-glossary a ga:Placement ; ga:component ex:glossary-component ; ga:order 2 ; ga:sectionKind "glossary" .
ex:reader-references a ga:Placement ; ga:component ex:references-component ; ga:order 3 ; ga:sectionKind "references" .
ex:reader-contract a ga:Placement ; ga:component ex:contract-component ; ga:order 4 ; ga:sectionKind "appendix" .

ex:overview-component a ga:Component ; dct:title "One graph, several publications" ; ga:fragment ex:overview-fragment .
ex:overview-fragment a ga:Fragment ; ga:subject ex:overview ; ga:body "A documentation graph connects **subjects**, authored prose, generated explanations, and publication instructions. A website and a review document can reuse that content while arranging it differently.\n\n## Read one graph in two ways\n\nThe reader website emphasizes navigation. The review document provides a contents page, numbered sections, appendices, and references. The shared fragments retain their identities in both outputs.\n\n- Collect source content through small, specialized adapters.\n- Assemble complete contributions into a validated revision.\n- Resolve each target against that revision before rendering.\n\n> An incomplete update must not replace a complete publication. A newer accepted rendering request supersedes older work.\n\nThe [publication contract](urn:showcase:contract) and [glossary](urn:showcase:glossary) are linked from the same documentable subjects in both formats.\n\n## Documentation vocabulary\n\nThe following table deliberately crosses page boundaries in the review document. Its header should repeat, its cells should wrap, and every row should remain legible.\n\n| Term | Meaning |\n| --- | --- |\n| Documentable subject | An identified resource that can be explained by authored and generated fragments. |\n| Authored fragment | Narrative supplied by an editor and retained as content independent of output layout. |\n| Generated fragment | An explanation derived from collected assertions, with a traceable subject and source. |\n| Collector instance | A configured adapter for one specific kind of input, with its own contribution ownership. |\n| Subject scope | A reusable selection that includes subjects, applies exclusions, and bounds relationship traversal. |\n| Logical component | A meaningful unit such as an introduction, definition, example, glossary, or reference list. |\n| Placement | A target-specific position for a logical component. It does not change the shared fragment. |\n| Publication profile | An arrangement and presentation definition that can be reused by several targets. |\n| Publication target | One named output binding a scope, profile, renderer, and artifact destination. |\n| Validated revision | A pinned set of complete contributions that passed the project definition checks. |\n| Graph writer | The coordinator receiving bounded contribution chunks from concurrent producers. |\n| Contribution chunk | A limited piece of normalized RDF that remains private until the contribution completes. |\n| Stable identity | An identifier that does not change merely because a render job or process restarts. |\n| External reference | An explicitly identified resource whose documentation is published outside this target. |\n| Source provenance | The relationship connecting content to its project, processor instance, and native source. |\n| Source revision | The observed input state used to decide whether generated content can be reused. |\n| Scope exclusion | An instruction removing a subject from the selected publication membership. |\n| Traversal boundary | An explicit limit preventing relationship expansion from consuming an entire connected graph. |\n| Web anchor | A fragment destination derived from target, placement, and shared content identities. |\n| Reading order | The sequence selected for a publication; it need not match website navigation. |\n| Glossary entry | A concise explanation of terminology used by the publication. |\n| Appendix | Supplementary material presented separately from the main numbered sections. |\n| Reference list | A collection of links identifying the standards and sources used by the document. |\n| Publication job | One rendering attempt whose result and provenance are recorded in the shared dataset. |\n| Manifest | The ownership and provenance record accompanying a completed set of artifacts. |\n| Draft preview | An authoring view that retains the last successful output when a new render fails. |\n| Revision comparison | A future view explaining the changes between two explicitly selected graph revisions. |\n| Static deployment | Publication of generated files without requiring Grapharch to serve reader requests. |\n\n## A source assertion stays data\n\nAn RDF assertion can be documented without turning the documentation body into executable Typst.\n\n```text\n<urn:example:fragment> <urn:example:subject> <urn:example:ontology> .\n#panic(\"This line is displayed as source text, never evaluated.\")\n```\n\nLiteral brackets such as `[subject]`, quotation marks, and the `#` character remain visible. [Return to the vocabulary table](#documentation-vocabulary).\n" ; ga:format "text/markdown" ; ga:contribution ex:authored .

ex:contract-component a ga:Component ; dct:title "Publication contract" ; ga:fragment ex:contract-fragment .
ex:contract-fragment a ga:Fragment ; ga:subject ex:contract ; ga:body "## Required publication behaviour\n\n1. Read a complete, validated source revision.\n2. Resolve references to included content or explicit external resources.\n3. Write a new generation without changing the visible output.\n4. Promote only the latest accepted request for that target.\n5. Keep artifacts belonging to other targets and user-owned files intact.\n\nThis appendix is intentionally placed after the main content in the specification and after the reference list in the reader website.\n" ; ga:format "text/markdown" ; ga:contribution ex:authored .

ex:glossary-component a ga:Component ; dct:title "Glossary" ; ga:fragment ex:glossary-fragment .
ex:glossary-fragment a ga:Fragment ; ga:subject ex:glossary ; ga:body "- **Contribution** - Normalized assertions owned by one source-processing attempt.\n- **Fragment** - Shared authored or generated content describing an identified subject.\n- **Plan** - A resolved target arrangement pinned to a validated graph revision.\n- **Target** - One requested output, such as a reader website or review document.\n" ; ga:format "text/markdown" ; ga:contribution ex:authored .

ex:references-component a ga:Component ; dct:title "References" ; ga:fragment ex:references-fragment .
ex:references-fragment a ga:Fragment ; ga:subject ex:references ; ga:body "1. [RDF 1.1 Concepts and Abstract Syntax](https://www.w3.org/TR/rdf11-concepts/).\n2. [Shapes Constraint Language (SHACL)](https://www.w3.org/TR/shacl/).\n3. [SPARQL 1.1 Query Language](https://www.w3.org/TR/sparql11-query/).\n" ; ga:format "text/markdown" ; ga:contribution ex:authored .
