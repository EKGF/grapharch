# EKGF documentation sites (principles, method, maturity, catalog) share the
# community identity without the ekgf.org header links; their footer lists
# the EKGF documentation sites and the website's own social links.
ga:EkgfDocumentationTheme ga:brandLogo <https://ekgf.org/ontology/grapharch/theme/ekgf#brand> ;
    ga:identityMark <https://ekgf.org/ontology/grapharch/theme/ekgf#omg> ;
    ga:siteFooter <https://ekgf.org/ontology/grapharch/theme/ekgf#documentation-footer> .
<https://ekgf.org/ontology/grapharch/theme/ekgf#documentation-footer> a ga:SiteFooter ;
    ga:footerGroup <https://ekgf.org/ontology/grapharch/theme/ekgf#footer-about>, <https://ekgf.org/ontology/grapharch/theme/ekgf#documentation-sites>, <https://ekgf.org/ontology/grapharch/theme/ekgf#footer-resources>, <https://ekgf.org/ontology/grapharch/theme/ekgf#documentation-connect> ;
    ga:footerLicense <https://ekgf.org/ontology/grapharch/theme/ekgf#cc-by-sa> ;
    ga:footerNote <https://ekgf.org/ontology/grapharch/theme/ekgf#footer-initiative> .
