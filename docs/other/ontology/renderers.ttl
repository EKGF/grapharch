@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

ga:HtmlRenderer a ga:Renderer, ga:PublicationRenderer ; rdfs:label "Single-document HTML"@en ; dct:description "One HTML document and stylesheet."@en .
ga:WebsiteRenderer a ga:Renderer, ga:PublicationRenderer ; rdfs:label "Website"@en ; dct:description "A multipage static documentation website."@en .
ga:SpecificationRenderer a ga:Renderer, ga:PublicationRenderer ; rdfs:label "Specification"@en ; dct:description "Standards-style HTML with a paired PDF."@en .
ga:SpecificationPagesRenderer a ga:Renderer, ga:PublicationRenderer ; rdfs:label "Paginated specification"@en ; dct:description "Linked standards-reference HTML pages."@en .
ga:BookshelfRenderer a ga:Renderer, ga:PublicationRenderer ; rdfs:label "Bookshelf"@en ; dct:description "Module books with individual HTML and PDF publications."@en .
ga:TypstRenderer a ga:Renderer, ga:PublicationRenderer ; rdfs:label "PDF"@en ; dct:description "PDF and editable Typst source."@en .

# Internal component shared by HTML and Typst/PDF publication renderers.
ga:OwlClassDiagramRenderer a ga:Renderer, ga:FragmentRenderer ;
    rdfs:label "UML class diagram"@en ;
    dct:description "Renders retained OWL class-neighborhood projections as linked SVG in HTML and Typst/PDF publications."@en .
