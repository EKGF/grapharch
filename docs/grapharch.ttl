@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doc: <urn:grapharch:docs:> .
@prefix artgov: <https://ekgf.org/ontology/artifact-governance#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
<urn:grapharch:docs> a ga:Project ; dct:title "Grapharch" ;
    ga:repository <https://github.com/EKGF/grapharch> ;
    dct:contributor doc:contributor-coates-anthony-b,
        doc:contributor-froehlich-marcel, doc:contributor-mattocks-carl,
        doc:contributor-rivett-pete, doc:contributor-seale-tony ;
    ga:showcasesSource "../examples" ;
    ga:scope doc:scope ; ga:target doc:website, doc:ontology-spec ;
    ga:collector doc:governance-source, doc:party-role-source,
        doc:role-composition-source, doc:dublin-core-source, doc:provenance-source .
doc:scope a ga:Scope .
doc:website a ga:Target ; dct:title "Grapharch documentation" ;
    ga:scope doc:scope ; ga:profile doc:profile ;
    ga:renderer <https://ekgf.org/ontology/grapharch#WebsiteRenderer> ; ga:destination "site" .
doc:profile a ga:Profile ; ga:theme ga:EkgfTheme ; ga:headerLink doc:header-specification .
doc:header-specification dct:title "Specification" ; ga:url "spec/develop/" ; ga:order 1 .

# This specification is generated from the actual vocabulary, not its overview page.
doc:ontology-spec a ga:Target ;
    dct:title "GraphArch Documentation and Publication Ontology" ;
    ga:subtitle "Vocabulary reference, model, and publication contract" ;
    ga:ontologySource "other/ontology/publication.ttl" ;
    ga:scope doc:ontology-scope ; ga:profile doc:ontology-profile ;
    ga:renderer <https://ekgf.org/ontology/grapharch#SpecificationRenderer> ; ga:destination "spec/develop" ;
    ga:publisher <urn:uuid:6c1408aa-039c-42f9-8dee-9c3f0009d61a> ; ga:publicationStatus "Editor's Draft" ;
    ga:publicationDate "2026-10-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
    ga:thisVersion <https://ekgf.github.io/grapharch/spec/develop/> ;
    ga:latestVersion <https://ekgf.github.io/grapharch/spec/develop/> ;
    ga:editorDraft <https://ekgf.github.io/grapharch/spec/develop/> ;
    ga:license <https://spdx.org/licenses/MIT> ;
    ga:copyright "Copyright (c) 2024-2025 Enterprise Knowledge Graph Forum, Object Management Group Inc. Development draft, distributed under the MIT license." .
doc:ontology-scope a ga:Scope ;
    ga:include artgov:Authority, artgov:authorityAcronym,
        cmns-pts:PartyRole, cmns-rlcmp:isPlayedBy,
        dct:title, dct:description, dct:source, dct:identifier,
        prov:Entity, prov:wasDerivedFrom, prov:atLocation .
doc:ontology-profile a ga:Profile .

# Explicit reference sources for the selected reused terms above.
# Each build records the actual upstream commit or response digest in its KG.
doc:governance-source a ga:CollectorUse ;
    ga:collectorType ga:GitRdfFileCollector ;
    ga:source "https://github.com/EKGF/ekg-ontologies.git" ;
    ga:sourcePath "ekgf-artifact-governance.ttl" ;
    ga:gitRef "HEAD" .
doc:party-role-source a ga:CollectorUse ;
    ga:collectorType ga:RdfUrlCollector ;
    ga:source "https://www.omg.org/spec/Commons/PartiesAndSituations/" ;
    ga:format "application/rdf+xml" .
doc:role-composition-source a ga:CollectorUse ;
    ga:collectorType ga:RdfUrlCollector ;
    ga:source "https://www.omg.org/spec/Commons/RolesAndCompositions/" ;
    ga:format "application/rdf+xml" .
doc:dublin-core-source a ga:CollectorUse ;
    ga:collectorType ga:RdfUrlCollector ;
    ga:source "https://www.dublincore.org/specifications/dublin-core/dcmi-terms/dublin_core_terms.rdf" ;
    ga:format "application/rdf+xml" .
doc:provenance-source a ga:CollectorUse ;
    ga:collectorType ga:RdfUrlCollector ;
    ga:source "https://www.w3.org/ns/prov-o.rdf" ;
    ga:format "application/rdf+xml" .
<urn:uuid:6c1408aa-039c-42f9-8dee-9c3f0009d61a> a <https://ekgf.org/ontology/artifact-governance#Authority> ; <http://www.w3.org/2000/01/rdf-schema#label> "Enterprise Knowledge Graph Forum" ;
    ga:shortName "EKGF" ; ga:accentColor "#2b5f9f" ; ga:url "https://ekgf.org/" .

<urn:uuid:6c1408aa-039c-42f9-8dee-9c3f0009d61a> <https://www.omg.org/spec/Commons/RolesAndCompositions/isPlayedBy> <urn:uuid:ee14e632-d8c2-43c1-95d8-72491ce7a846> .
<urn:uuid:ee14e632-d8c2-43c1-95d8-72491ce7a846> a <https://www.omg.org/spec/Commons/Organizations/Organization> ; <http://www.w3.org/2000/01/rdf-schema#label> "Enterprise Knowledge Graph Forum"@en .

# GraphArch contributors; local identities are not contact URLs or editorial roles.
doc:contributor-coates-anthony-b a prov:Person ;
    rdfs:label "Anthony B. Coates" ;
    dct:description "Contributed feedback on the readability of documented SHACL SPARQL constraints."@en .
doc:contributor-froehlich-marcel a prov:Person ; rdfs:label "Marcel Fröhlich" .
doc:contributor-mattocks-carl a prov:Person ; rdfs:label "Carl Mattocks" .
doc:contributor-rivett-pete a prov:Person ; rdfs:label "Pete Rivett" .
doc:contributor-seale-tony a prov:Person ; rdfs:label "Tony Seale" .

# Primary sections select existing page identities; URLs and content stay unchanged.
doc:profile ga:layout "sectioned" ; ga:navigation doc:sections .
doc:sections a ga:Navigation ; dct:title "GraphArch sections" ;
    ga:navigationRegion "primary" ; ga:navigationEntry doc:overview-section,
        doc:documentation-section, doc:gallery-section, doc:things-section,
        doc:features-section, doc:collectors-section, doc:renderers-section, doc:other-section, doc:overview-guide .
doc:overview-section a ga:NavigationEntry ; dct:title "Overview" ; ga:order 1 ;
    ga:page <urn:grapharch:docs:topic:index> .
doc:documentation-section a ga:NavigationEntry ; dct:title "Documentation" ; ga:order 2 ;
    ga:page <urn:grapharch:docs:topic:usage> .
doc:gallery-section a ga:NavigationEntry ; dct:title "Gallery" ; ga:order 5 ;
    ga:page <urn:grapharch:docs:topic:showcase-gallery> .
doc:things-section a ga:NavigationEntry ; ga:order 1 ; ga:parentEntry doc:documentation-section ;
    ga:page <urn:grapharch:docs:topic:documentable-things> .
doc:features-section a ga:NavigationEntry ; ga:order 2 ; ga:parentEntry doc:documentation-section ;
    ga:page <urn:grapharch:docs:topic:features> .
doc:collectors-section a ga:NavigationEntry ; dct:title "Collectors" ; ga:order 3 ;
    ga:page <urn:grapharch:docs:collectors:readme> .
doc:renderers-section a ga:NavigationEntry ; dct:title "Renderers" ; ga:order 4 ;
    ga:page <urn:grapharch:docs:renderers:readme> .
doc:other-section a ga:NavigationEntry ; ga:order 5 ; ga:parentEntry doc:documentation-section ;
    ga:page <urn:grapharch:docs:topic:other> .

doc:overview-guide a ga:NavigationEntry ; ga:order 0 ; ga:parentEntry doc:documentation-section ;
    ga:page <urn:grapharch:docs:topic:overview> .
