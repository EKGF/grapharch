@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix st: <urn:example:submission-theme:> .

# A consumer-defined restrained submission theme: US Letter, serif body,
# black sans headings, a plain ruled cover and Roman then Arabic numbering.
st:theme a ga:Theme ;
    ga:baseTheme ga:SpecificationTheme ;
    ga:paper "us-letter" ; ga:marginTop "1in" ; ga:marginBottom "1in" ;
    ga:marginLeft "1in" ; ga:marginRight "1in" ;
    ga:coverBands false ; ga:statusRibbon false ; ga:runningHeader false ;
    ga:accent "#000000" ; ga:authorityAccent false ;
    ga:inkColor "#000000" ; ga:mutedColor "#000000" ; ga:ruleColor "#999999" ;
    ga:panelColor "#f4f4f4" ; ga:headingColor "#000000" ; ga:linkColor "#000000" ;
    ga:bodyFont "Liberation Serif" ; ga:bodySize "10pt" ; ga:leading "0.55em" ;
    ga:paragraphSpacing "0.8em" ; ga:headingFont "Liberation Sans" ;
    ga:heading1Size "18pt" ; ga:heading1Weight "bold" ; ga:heading2Size "14pt" ;
    ga:heading3Size "12pt" ; ga:heading4Size "11pt" ;
    ga:tableHeaderFill "#f4f4f4" ; ga:tableRuleColor "#999999" ;
    ga:codeHighlight false ; ga:tintedCallouts false ;
    ga:footerFont "Liberation Sans" ; ga:footerSize "9pt" ; ga:footerColor "#000000" ;
    ga:footerRule false ; ga:footerShowsText true ; ga:pageNumberColor "#000000" ;
    ga:pageNumberBold false ; ga:pageOfTotal false ;
    ga:frontNumbering "i" ; ga:bodyNumbering "1" ;
    ga:noticeFont "Liberation Serif" ; ga:tocTitleSize "18pt" ;
    ga:coverBlock st:publisher, st:gap, st:title, st:subtitle, st:rule-gap, st:rule, st:summary-gap, st:summary .
st:publisher a ga:CoverBlock ; ga:order 1 ; ga:coverElement ga:CoverPublisher ; ga:fontSize "12pt" .
st:gap a ga:CoverBlock ; ga:order 2 ; ga:coverElement ga:CoverSpace ; ga:space "30mm" .
st:title a ga:CoverBlock ; ga:order 3 ; ga:coverElement ga:CoverTitle ; ga:fontSize "26pt" ; ga:fontWeight "bold" .
st:subtitle a ga:CoverBlock ; ga:order 4 ; ga:coverElement ga:CoverSubtitle ; ga:fontSize "16pt" .
st:rule-gap a ga:CoverBlock ; ga:order 5 ; ga:coverElement ga:CoverSpace ; ga:space "10mm" .
st:rule a ga:CoverBlock ; ga:order 6 ; ga:coverElement ga:CoverRule ; ga:stroke "0.6pt" ; ga:color "#000000" .
st:summary-gap a ga:CoverBlock ; ga:order 7 ; ga:coverElement ga:CoverSpace ; ga:space "7mm" .
st:summary a ga:CoverBlock ; ga:order 8 ; ga:coverElement ga:CoverSummary ; ga:fontSize "10pt" .
